use @piton/config
use @piton/belay

from @piton/belay import ClaudeAdapter, OpenCodeAdapter

export piton-config PitonLanguageTest:
    root: ./spec
    entry: ./spec/index.pi

    frameworks:
        - {BelayConfiguration}

    // packages:
    // - {Piton}

belay-config BelayConfiguration:
    codeRoot: ./crates
    shapeRoot: ./spec/shape

    adapters:
        - {ClaudeAdapter}
        - {OpenCodeAdapter}

