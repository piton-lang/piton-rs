use @piton/packaging
use @piton/config
use @piton/belay
use @piton/test

from @piton/belay import ClaudeCodeAdapter, OpenCodeAdapter

export piton-config PitonLanguageTest:
    root: ./spec
    entry: ./spec/index.pi

    plugins:
        - {BelayConfiguration}
        - {Tests}

    packages:
        - {Piton}

    dependencies:
        - https://github.com/emul-lang/emul-rs.git

belay-config BelayConfiguration:
    codeRoot: ./crates
    shapeRoot: ./spec/shape

    adapters:
        - {ClaudeCodeAdapter}
        - {OpenCodeAdapter}

// The code of this project is in crates and in plugins. The tests judge
// both, so the code root of the tests is the project root.
test-config Tests:
    codeRoot: .

piton-package Piton:
    name: piton
    root: ./spec
