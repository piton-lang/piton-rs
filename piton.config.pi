use @piton/packaging
use @piton/config
use @piton/belay

from @piton/belay import ClaudeCodeAdapter, OpenCodeAdapter

export piton-config PitonLanguageTest:
    root: ./spec
    entry: ./spec/index.pi

    plugins:
        - {BelayConfiguration}

    packages:
        - {Piton}

    dependencies:
        - https://github.com/emul-lang/emul-rs.git

belay-config BelayConfiguration:
    codeRoot: ./crates
    shapeRoot: ./spec/shape

    adapters:
        - {ClaudeCodeAdapter}
        - {OpenCodeAdapter}

piton-package Piton:
    name: piton
    root: ./spec
