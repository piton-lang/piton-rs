use @piton/test

export test FormatUsesFourSpaces:
    expects: piton format indents with four spaces, and that is not configurable.
    tags: [tooling]

export test CheckWritesNothing:
    expects: piton check never writes a file.
    tags: [tooling]

export test TestsWithoutAVerdictAreErrors:
    expects:
        piton test reports a test whose agent ends without a verdict line as an
        error that was never judged, not as a failure.
    against: code
    tags: [tooling]

export test MigrationToPluginConfig:
    expects:
        Any command that would otherwise error out over legacy config syntax
        should offer an automatic migration to the new syntax.
    tags: [tooling, migration, config]

export test AgentModels:
    expects:
        Any tool that allows selecting an agent should also offer the ability
        to select a model.  And if no model is selected it should list the
        models available.

        So in other words `piton test --agent opencode` will use whatever the
        default opencode model is, and piton test --agent opencode --model`
        will list the available models.

        You can also put a --model searchString and it'll filter the results.
        And if nothing is found, it'll list everything.

    tags: [tooling, agents, models]
