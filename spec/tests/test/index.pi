from @piton/test import Test

abstract anchor MyTest extends Test as test:
    tags:
        - test

export test FreshContext:
    expects:
        Each test during `piton test` should run against a new agent with a
        fresh context.

export test Implementation:
    expects:
        The test behaviour and implementation is via the Piton plugin
        architecture, and the implementation is in Typescript.

export test ExtendsTestKeyword:
    expects:
        The core `Test` anchor from @piton/test can be extended in Piton
        for example MyTest extends Test as my-test and whether a test is
        declared with `my-test` or `extends MyTest` it will still get picked up
        by the test framework.

export test UndefinedBehavior:
    expects:
        Undefined behaviour in either the spec or the code will fail a test.

export test ModedFailure:
    expects:
        A test that passes in spec and fails in code should or vice versa should
        display both, but ultimately is a fail.
