use @piton/belay

from @piton/belay import BELAY_PROJECT_ROOT

export skill GenerateFluencyPrompt:
    useWhen: Explicitly called
    description: Generates a Piton fluency prompt for the agent
    prompt:
        Use the entire spec of Piton to generate a fluency prompt for the agent.
        It should be thorough, documenting every feature of behaviour of the
        language and frameworks -- everything that Piton+family supports.

        The goal is that the agent can use this prompt to understand and work on
        a Piton specbase.

        Output the results into ${FLUENCY_PROMPT_FILE}

export FLUENCY_PROMPT_FILE: ${BELAY_PROJECT_ROOT}/FLUENCY_PROMPT.md
