use @piton/belay

export skill BuildTooling:
    description:
        Read the spec for the Piton language, Belay framework and all
        associated concepts required to build the tooling and build the tooling.

    useWhen: Explicitly Invoked

    prompt:
        Read the complete spec for the Piton, Belay framework, and all
        associated features, tooling, etc under .claude/reference and understand
        the everything.  Then build the tooling as described completely and
        thoroughly.

    stack:
        - Rust
        - chumsky
        - rowan
        - tower-lsp

    xtask:
        install:
            Should build the release and install it locally.
