use @piton/belay

from @piton/belay import BELAY_PROJECT_ROOT

export command CheckSpecForProblems:
    description: Checks the spec for problems.

    prompt:
        Your goal is to read the spec in ${BELAY_PROJECT_ROOT}/spec and look for
        problems, specifically with things that are underdefined, overdefined,
        or contradictions.  You should also look for things that are poorly
        organized.

        Once you've made an assessment, present the findings to the user one by
        one, giving the option to select the source of truth if appropriate, or
        add clarification, etc.
