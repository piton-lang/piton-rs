from ./Framework import
    ConstructComposition,
    FrameworkBoundaries,
    FrameworkPurpose,
    ProjectConfiguration,
    SourceAuthority
from ./anchors/Instruction import InstructionBehavior
from ./anchors/Skill import SkillBehavior
from ./anchors/Command import CommandBehavior
from ./anchors/Agent import AgentBehavior
from ./Scope import
    AnchorReferences,
    ShapeMapping,
    ShapeRootReference
from ./Compilation import Compilation
from ./adapters/ClaudeCode import ClaudeCodeAdapter
from ./adapters/Codex import CodexAdapter
from ./adapters/OpenCode import OpenCodeAdapter
from ./Decisions import
    OpenDecisions,
    ProposedBuildGuarantees,
    ProposedPermissionBoundary

export anchor Belay:
    description:
        A Piton framework for structured agent instructions, skills, commands,
        and agents, compiled into the formats used by agentic coding tools.

    specialImports:
        The following special imports can be brought in from `@piton/belay` and
        used.

        - BELAY_AGENT_ROOT
            resolves to the path of the agent being compiled -- so that might be
            .claude or .opencode, etc.

        - BELAY_PROJECT_ROOT
            resolves to the path of the project

        - BELAY_SHAPE_ROOT
            resolves to the path of the shape as configured in the project
            config. if not specified, it will resolve to the project root

        - BELAY_CODE_ROOT
            resolves to the path of the code as configured in the project
            config. if not specified, it will resolve to the project root

    framework:
        - {FrameworkPurpose}
        - {SourceAuthority}
        - {FrameworkBoundaries}
        - {ProjectConfiguration}
        - {ConstructComposition}

    anchors:
        - {InstructionBehavior}
        - {SkillBehavior}
        - {CommandBehavior}
        - {AgentBehavior}
    compilation: {Compilation}

    scope:
        - {ShapeMapping}
        - {ShapeRootReference}
        - {AnchorReferences}

    adapters:
        - {ClaudeCodeAdapter}
        - {CodexAdapter}
        - {OpenCodeAdapter}

    proposedRefinements:
        - {ProposedBuildGuarantees}
        - {ProposedPermissionBoundary}

    unresolved: {OpenDecisions}
