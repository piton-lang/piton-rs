from ../../../plugins/belay/pi/adapters/ClaudeCode import ClaudeCodeAdapter
from ../../../plugins/belay/pi/adapters/Codex import CodexAdapter
from ../../../plugins/belay/pi/adapters/Muse import MuseAdapter
from ../../../plugins/belay/pi/adapters/OpenCode import OpenCodeAdapter
from ./Compilation import Compilation
from ./Decisions import
    BuildGuarantees,
    OpenDecisions,
    PermissionBoundary
from ./Framework import
    ConstructComposition,
    FrameworkBoundaries,
    FrameworkPurpose,
    ProjectConfiguration,
    SourceAuthority
from ./Plugin import BelayPlugin
from ./Scope import
    AnchorReferences,
    ShapeMapping,
    ShapeRootReference
from ./anchors/Agent import AgentBehavior
from ./anchors/Command import CommandBehavior
from ./anchors/Instruction import InstructionBehavior
from ./anchors/Skill import SkillBehavior

export anchor Belay:
    description:
        A Piton framework for structured agent instructions, skills, commands,
        and agents, compiled into the formats used by agentic coding tools.

    plugin: @{BelayPlugin}

    specialImports:
        description:
            The following special imports can be brought in from `@piton/belay`
            and used. They're the Belay plugin's placeholders: filled in by
            Belay's build, for each adapter, as a path relative to the file
            they end up in. Anywhere else, like the output of `piton compile`
            or the renderer's output of `piton build`, the project root
            resolves the same way, the code and shape roots are written as the
            project root, and the agent root and compiled shape, which only
            exist for an adapter, are written as their names.

        BELAY_AGENT_ROOT: The agent's directory, so that might be .claude, .codex, .opencode or .muse.
        BELAY_PROJECT_ROOT: The project, where piton.config.pi lives.
        BELAY_SHAPE_ROOT: The shape as configured in the project config. If not specified, it's the project root.
        BELAY_CODE_ROOT: The code as configured in the project config.
        BELAY_COMPILED_SHAPE: The compiled copy of the shape for the agent, under its reference directory.

    framework:
        - @{FrameworkPurpose}
        - @{SourceAuthority}
        - @{FrameworkBoundaries}
        - @{ProjectConfiguration}
        - @{ConstructComposition}

    anchors:
        - @{InstructionBehavior}
        - @{SkillBehavior}
        - @{CommandBehavior}
        - @{AgentBehavior}
    compilation: @{Compilation}

    scope:
        - @{ShapeMapping}
        - @{ShapeRootReference}
        - @{AnchorReferences}

    adapters:
        - @{ClaudeCodeAdapter}
        - @{CodexAdapter}
        - @{OpenCodeAdapter}
        - @{MuseAdapter}

    guarantees:
        - @{BuildGuarantees}
        - @{PermissionBoundary}

    unresolved: @{OpenDecisions}
