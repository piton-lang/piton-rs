from ../lib/Operator import Operator
from ./TernaryOperator import TernaryOperator

export anchor ConditionalOperators:
    description:
        Picks between two values based on a boolean.

        Ternary is just a fun word to say, kind of like "Guido" is fun to
        say. But my name isn't Guido, so I have to include the ternary
        operators in the language.
    operators: {CONDITIONAL_OPERATORS}

export CONDITIONAL_OPERATORS:: extends Operator[]:
    - {TernaryOperator}
