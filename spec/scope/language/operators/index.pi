from ./ControlFlow import ControlFlow
from ./arithmetic import ARITHMETIC_OPERATORS, ArithmeticOperators
from ./comparison import COMPARISON_OPERATORS, ComparisonOperators
from ./logical import LOGICAL_OPERATORS, LogicalOperators
from ./access import ACCESS_OPERATORS, AccessOperators
from ./concatenation import CONCATENATION_OPERATORS, ConcatenationOperators
from ./conditional import CONDITIONAL_OPERATORS, ConditionalOperators

export anchor Operators:
    ControlFlow: {ControlFlow}

    StandardOperators:
        Piton supports a pretty standard if not small set of operators, plus a
        few slightly more unique ones. Let’s start with the standard ones.

    AccessOperators: {AccessOperators}
    ArithmeticOperators: {ArithmeticOperators}
    ComparisonOperators: {ComparisonOperators}
    ConcatenationOperators: {ConcatenationOperators}
    ConditionalOperators: {ConditionalOperators}
    LogicalOperators: {LogicalOperators}
    allOperators:
        + {ACCESS_OPERATORS}
        + {ARITHMETIC_OPERATORS}
        + {COMPARISON_OPERATORS}
        + {CONCATENATION_OPERATORS}
        + {CONDITIONAL_OPERATORS}
        + {LOGICAL_OPERATORS}
