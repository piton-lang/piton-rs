from ../arithmetic/AdditionOperator import AdditionOperator
from ../lib/Operator import Operator
from ./ConcatenationOperator import ConcatenationOperator
from ./DupMergeOperator import DupMergeOperator
from ./MergeOperator import MergeOperator

export anchor ConcatenationOperators:
    description: Operators that join strings, lists, and dictionaries.

    operators: {CONCATENATION_OPERATORS}

    plusDispatch:
        The `+` symbol is shared by @{AdditionOperator},
        @{ConcatenationOperator}, and @{MergeOperator}. Which one you get
        depends on the types on each side.

        ```markdown
        \\\
        | Left       | Right      | Operation                              |
        | ---------- | ---------- | -------------------------------------- |
        | number     | number     | AdditionOperator                       |
        | string     | simple     | ConcatenationOperator                  |
        | simple     | string     | ConcatenationOperator                  |
        | string     | complex    | implicit list                          |
        | complex    | string     | implicit list                          |
        | list       | list       | MergeOperator                          |
        | dictionary | dictionary | MergeOperator                          |
        | other      | other      | compiler error                         |
        \\\
        ```

export CONCATENATION_OPERATORS:: extends Operator[]:
    - {ConcatenationOperator}
    - {MergeOperator}
    - {DupMergeOperator}
