use ./lib/Type
from ../operators/comparison/EqOperator import EqOperator
from ../operators/comparison/NeqOperator import NeqOperator
from ../operators/logical import LOGICAL_OPERATORS

export type Booleans:
    description:
        Booleans are represented with lowercase `true` and `false`.

    supportedOperators:
        + {LOGICAL_OPERATORS}
        - {EqOperator}
        - {NeqOperator}
