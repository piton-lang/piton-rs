use ./lib/Type
from ../operators/concatenation/MergeOperator import MergeOperator
from ../operators/concatenation/DupMergeOperator import DupMergeOperator
from ../operators/comparison/EqOperator import EqOperator
from ../operators/comparison/NeqOperator import NeqOperator

export type Lists:
    description:
        Lists can be defined two ways, Markdown/YAML-style or inline.

        ```piton
        \\\
        markdownStyle:
            - One
            - List
            - Item
            - Per
            - Line

        inlineStyle: [This, is, a, list, of, strings]
        \\\
        ```

    nestedLists:
        It’s possible to do nested lists:

        ```piton
        \\\
        nestedMarkdownList:
            - Level 1
                - Level 2
                    - Level 3
        \\\
        ```

        Which is equivalent to:

        ```piton
        \\\
        inlineMultiList: [Level 1, [Level 2, [Level 3]]]
        \\\
        ```

    access:
        Piton intentionally does not provide a way to access items within a
        list. Because this is not a runtime-based general purpose language but
        rather a language designed for description, a list is a construct
        intended for merging via inheritance; myList[0] is not very descriptive,
        is it?

    supportedOperators:
        - {MergeOperator}
        - {DupMergeOperator}
        - {EqOperator}
        - {NeqOperator}
