use ./lib/Type

from ../operators/concatenation/MergeOperator import MergeOperator
from ../operators/concatenation/DupMergeOperator import DupMergeOperator
from ../operators/lib/Operator import Operator
from ../variables/TypeCoercion import TypeCoercion

export type Dictionaries:
    description:
        Dictionaries are nested keys and values, and there is only a single way
        to define them:

        ```piton
        \\\
        firstLevel:
            secondLevel:
                thirdLevel: This is a string
        \\\
        ```

        You can use dot syntax to access keys in a dictionary.
        firstLevel.secondLevel.thirdLevel would yield “This is a string”.

        Object keys can include hyphens and underscores as well as valid Unicode
        letter characters and Unicode numeric characters. They cannot include
        spaces.

    supportedOperators:: Operator[]
        - {MergeOperator}
        - {DupMergeOperator}

    validKeys:
        Anything that can support @{TypeCoercion} to a string is a valid key,
        so long as it doesn't contain spaces.

        So for example, `thisIsAKey` and `123` and `foo-bar` and `false` and
        `null` are all valid keys and will be treated as strings, while
        `This is a key` and `1 2 3` are not.
