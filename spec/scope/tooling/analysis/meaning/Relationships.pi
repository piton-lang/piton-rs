from ../structure import StructuralContext
from ../LanguageData import RelationVerbs

export abstract anchor RelationshipKind as relationship-kind:
    description:: string
    source:: string
    target:: string
    comesFrom:: string

export anchor Relationships:
    description:
        A relationship is a directed link between two things in the model:
        one thing defines, contains, inherits from, or invokes another. Some
        relationships are written as Piton structure and are read straight
        from it, as described in @{StructuralContext}. Others are stated in
        prose, through the verbs in @{RelationVerbs}. A few are created by
        analysis itself to keep track of where facts came from.

        The kinds below are the only relationship kinds. The comesFrom of
        each says whether it is read from structure, from prose, or from
        analysis.

    kinds: {RELATIONSHIP_KINDS}

export relationship-kind Defines:
    description: An anchor declares a property, which becomes a part of it.
    source: an entity or part
    target: one of its parts
    comesFrom: structure

export relationship-kind Inherits:
    description:
        An anchor extends another, directly or through a keyword. The parts
        and facts of the base apply to the anchor unless it overrides them.

    source: an entity
    target: its base
    comesFrom: structure

export relationship-kind References:
    description:
        Something points at something else by name, through @, dollar or
        brace references in Piton, or through an import.

    source: an entity or part
    target: the thing named
    comesFrom: structure

export relationship-kind Contains:
    description:
        One thing is part of another. Structure says this through nesting;
        prose says it with possessives, such as its text, or with verbs such
        as contains.

    source: the whole
    target: the part
    comesFrom: structure or prose

export relationship-kind Classifies:
    description: Prose says one thing is a kind of another, as in a button is a control.
    source: the specific thing
    target: the general thing
    comesFrom: prose

export relationship-kind Requires:
    description: Prose says one thing needs another to work, as in the form requires a user.
    source: the thing that needs
    target: the thing needed
    comesFrom: prose

export relationship-kind Invokes:
    description: An event on one thing causes another thing to run, as in when clicked, its action is invoked.
    source: the thing that causes
    target: the thing run
    comesFrom: prose

export relationship-kind Modifies:
    description: One thing changes another, as in dimming changes the button's color.
    source: the thing that changes
    target: the thing changed
    comesFrom: prose

export relationship-kind Conditions:
    description:
        A condition limits when a fact holds. The link runs from the condition
        to every fact it limits.

    source: a condition
    target: a fact
    comesFrom: analysis

export relationship-kind StatedIn:
    description: A fact was read from a statement.
    source: a fact
    target: the statement or structure it came from
    comesFrom: analysis

export relationship-kind DerivedFrom:
    description: A fact was derived by a rule from other facts.
    source: a derived fact
    target: each fact it was derived from
    comesFrom: analysis

export RELATIONSHIP_KINDS:: extends RelationshipKind[]:
    - {Defines}
    - {Inherits}
    - {References}
    - {Contains}
    - {Classifies}
    - {Requires}
    - {Invokes}
    - {Modifies}
    - {Conditions}
    - {StatedIn}
    - {DerivedFrom}
