from ./DerivationStates import DerivationState, DerivationStates
from ./Strengths import Strength, Strengths
from ./Conditions import Conditions
from ./Provenance import Provenance, SourceRecord
from ./Patterns import Patterns

export abstract anchor FactForm as fact-form:
    description:: string
    notation:: string

export abstract anchor Fact:
    id:: string
    subject:: string
    aspect:: null:: string
    form:: FactForm
    value:: any
    positive:: boolean
    strength:: Strength
    conditions:: string[]
    state:: DerivationState
    provenance:: SourceRecord

export anchor Facts:
    description:
        A fact is one small piece of meaning that an implementation can be
        checked against. The button is blue is one fact. When disabled, the
        button cannot be clicked is also one fact, which holds only under a
        condition.

        Facts are the center of analysis. Everything before this point exists
        to produce them, and everything after it measures them, connects
        them, or turns them into instructions.

    parts:
        Every fact has the same parts. The shape is given by the Fact anchor
        below; this is what each part means.

        ```text
        subject     the thing the fact is about             Button
        aspect      which side of it, when there is one     color
        form        what kind of claim is made              value
        value       what is claimed                         blue
        positive    false when the claim is negated         true
        strength    how firmly it binds                     required
        conditions  when it holds; none means always        (none)
        state       how analysis knows it                   stated
        provenance  where it came from                      button.pi:6
        ```

        The subject and aspect are paths. A subject is an entity name, or an
        entity name followed by the names of its parts, such as Button.text.
        The strength is one of those in @{Strengths}, the state one of those
        in @{DerivationStates}, the conditions are described in
        @{Conditions}, and provenance in @{Provenance}.

    forms:
        Different sentences make different kinds of claim, and each kind has a
        form. The forms are the canonical shapes every fact is normalized
        into, however it was worded. They are listed in FACT_FORMS below.

    notation:
        This specification writes facts in a short notation. It is a way of
        showing facts to people, not a file format.

        ```text
        Button.color = blue
        Button.state is one of enabled, disabled
        Button can be clicked
        on Button clicked: invoke Button.action
        when Button.state = disabled: Button cannot be clicked
        Button.? = teal                                  (? marks an unresolved part)
        ```

    identity:
        Every fact has an id that stays the same as long as its source does.
        A stated fact is named by its file, entity, property path and the
        position of its statement and of the fact within it, as in
        button.pi#Button.disabled/s3/f1. A structural fact is named by the
        declaration it was read from. A derived fact is named by its rule
        followed by the ids of its inputs. Two runs over the same files give
        every fact the same id.

    fromStatementToFact:
        How a statement becomes a fact, and when it does not, is described in
        @{Patterns}.

    factForms: {FACT_FORMS}

export fact-form ValueForm:
    notation: subject.aspect = value
    description:
        Something has a value. The value is a word, a number, a quoted text, a
        reference to something defined, or a transformation of another value,
        written as the transformation's name applied to that value, as in
        dim(Button.color).

export fact-form ChoiceForm:
    notation: subject.aspect is one of value, value, ...
    description:
        Something has exactly one of a fixed set of values at a time. The
        values are listed, and no value outside them is allowed.

export fact-form CapabilityForm:
    notation: subject can [be] action
    description:
        Something can do an action, or can have an action done to it. A
        negated capability, subject cannot be clicked, is a fact in its own
        right, not a missing one. When the action has an able form in the
        language data, the capability is shown under that name as well, so
        Button can be clicked is also shown as Button.clickable = true.

export fact-form TriggerForm:
    notation: on subject action: effect
    description:
        When an action happens to something, something else follows. The
        effect is either another fact that becomes true, or something that is
        run, recorded with the Invokes relationship.

export fact-form RelationForm:
    notation: subject kind target
    description:
        Two things are related by one of the relationship kinds, such as
        Button contains Button.text or Form requires User.

export FACT_FORMS:: extends FactForm[]:
    - {ValueForm}
    - {ChoiceForm}
    - {CapabilityForm}
    - {TriggerForm}
    - {RelationForm}
