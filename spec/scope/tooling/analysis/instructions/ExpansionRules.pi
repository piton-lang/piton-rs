from ../meaning/Facts import CapabilityForm, ChoiceForm
from ../LanguageData import ActionNouns

export abstract anchor ExpansionRule as expansion-rule:
    description:: string
    appliesTo:: string
    adds:: string
    example:: string

export anchor ExpansionRules:
    description:
        An expansion rule says one requirement more than one way, because an
        implementer who reads a requirement from two directions is less
        likely to miss what it means. Every sentence an expansion adds must
        follow from the fact alone, by the definition of that fact's form.
        An expansion never adds a requirement the fact does not contain.

        These are the only expansions. A project cannot add its own, for the
        same reason it cannot add derivation rules: each one widens what an
        implementer is told the specification requires.

    rules: {EXPANSION_RULES}

export expansion-rule RestateCondition:
    description:
        A requirement that holds under a condition repeats the condition in
        its own sentence, even though it is also listed under a heading for
        that condition, so that no sentence can be read without it.

    appliesTo: every requirement with conditions
    adds: the conditions, as a While clause at the start of the sentence
    example: While Button.state is disabled, Button MUST NOT be clickable.

export expansion-rule ChoiceExclusivity:
    description:
        A choice means exactly one of a fixed set of values, as the
        @{ChoiceForm} defines it. Both halves of that are said: that one of
        the values holds, and that no other value does.

    appliesTo: every choice fact
    adds: a sentence forbidding every value outside the set
    example:
        Button.state MUST have exactly one of these values at any time:
        enabled, disabled. It MUST NOT have any other value.

export expansion-rule CapabilityAsInput:
    description:
        A thing that cannot have an action done to it does not accept that
        action, as the @{CapabilityForm} defines it. When the action has a
        noun in @{ActionNouns}, the requirement is also said in terms of that
        input.

    appliesTo: every negated capability whose action has an action noun
    adds: a sentence saying the input is not accepted
    example:
        While Button.state is disabled, Button MUST NOT be clickable. A click
        on Button MUST NOT be accepted.

export EXPANSION_RULES:: extends ExpansionRule[]:
    - {RestateCondition}
    - {ChoiceExclusivity}
    - {CapabilityAsInput}
