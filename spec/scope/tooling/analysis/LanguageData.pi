from ./meaning/Strengths import Strengths
from ./meaning/Relationships import Relationships

export abstract anchor WordList as word-list:
    description:: string
    words:: string[]
    except:: string[]: []
    matchCase:: boolean: false

export abstract anchor WordMap as word-map:
    description:: string
    pairs:: dictionary

export abstract anchor ValueClass as value-class:
    description:: string
    aspect:: string
    words:: string[]

export anchor LanguageData:
    description:
        Everything analysis knows about English is written down as language
        data. Nothing is learned, guessed or downloaded while it runs. If a
        word is not in the language data, analysis does not know what it
        means, and says so.

        Language data comes in two sizes. Small, closed groups of words, such
        as the words that negate a statement, can be listed completely, and
        they are listed in this file. Large, open groups, such as every
        English noun, cannot, so they live in a dictionary that ships with the
        analyzer and is identified by its version.

    closedLists:
        A word list names a small group of words that play one role. Matching
        is by whole word, or by consecutive words for a phrase, ignoring case
        unless the list sets matchCase. Wherever one of a list's exceptions
        matches, the words inside it do not count: that is how standard can
        be a vague word while standard output is not.

        The built-in lists are the anchors in WORD_LISTS below. A project can
        extend one with ordinary Piton inheritance, and its version is then
        used in place of the built-in one.

        ```piton
        // word-list comes from the analysis module. It is declared here only so
        // that this example compiles on its own.
        abstract anchor WordList as word-list:
            description:: string
            words:: string[]

        word-list Hedges:
            description: The built-in hedges, shortened here.
            words:
                - maybe
                - perhaps

        word-list ProjectHedges extends Hedges:
            description: Our hedges, plus the ones our authors like.
            words:
                + {super.words}
                - more often than not
        ```

    dictionary:
        The dictionary holds the open groups: which classes each known word
        can belong to, the base form of inflected words, such as click for
        clicked and clicks, and the plural and singular of nouns. This
        specification defines what the dictionary must contain, not its
        contents, which are too large to list here. The dictionary is
        identified by a name and version, and a report always records both.

    derivedForms:
        Some word relationships matter enough to list explicitly, because
        rules depend on them.

        ```text
        able forms         click -> clickable, select -> selectable
        action nouns       click -> click, clicks; select -> selection
        transformations    verbs that change a value: dim, brighten, hide, blur
        relation verbs     verbs that relate two things: contains, requires, uses
        ```

        They are listed in the word maps AbleForms, ActionNouns and
        RelationVerbs and the word list TransformationVerbs below. A verb
        missing from them is still a verb; it simply cannot take part in the
        rules that need these forms.

    valueClasses:
        A value class says which aspect a descriptive word is about. Knowing
        that blue is a color is what lets analysis read the button is blue as
        a statement about the button's color, rather than about some unnamed
        aspect of it. Value classes are listed in VALUE_CLASSES below, and a
        project can add its own.

    wordLists: {WORD_LISTS}
    wordMaps: {WORD_MAPS}
    valueClassList: {VALUE_CLASSES}

export word-list Negations:
    description: Words that turn a statement into its opposite.
    words:
        - not
        - no
        - never
        - cannot
        - can't
        - won't
        - doesn't
        - don't
        - isn't
        - aren't
        - nothing
        - none

export word-list Modals:
    description:
        Words that set how strongly a statement binds. Their meaning is given
        in @{Strengths}.

    words:
        - must
        - shall
        - should
        - may
        - can
        - cannot
        - might
        - could
        - will

export word-list ConditionMarkers:
    description:
        Words that open a condition. Unless is also a negation: unless X
        means when not X.

    words:
        - when
        - whenever
        - while
        - if
        - once
        - unless
        - as long as

export word-list Pronouns:
    description: Words that stand for something named elsewhere.
    words:
        - it
        - its
        - itself
        - they
        - them
        - their
        - this
        - these

export word-list Determiners:
    description: Words that introduce a noun without naming it.
    words:
        - a
        - an
        - the
        - each
        - every
        - any
        - all
        - some
        - no

export word-list Conjunctions:
    description: Words that join two statements or two parts of one.
    words:
        - and
        - or
        - but
        - either
        - nor

export word-list Hedges:
    description:
        Words that soften a statement until it no longer commits to a rule.

    words:
        - maybe
        - perhaps
        - probably
        - possibly
        - likely
        - usually
        - generally
        - typically
        - often
        - sometimes
        - mostly
        - roughly
        - somewhat
        - sort of
        - kind of
        - more or less

export word-list DegreeWords:
    description:
        Words that say how much, without saying how much exactly.

    words:
        - slightly
        - very
        - much
        - a little
        - a bit
        - fairly
        - quite
        - rather
        - extremely
        - more
        - less

export word-list VagueWords:
    description:
        Judgment words that stand in for a criterion nobody wrote down.

    words:
        - appropriate
        - reasonable
        - sensible
        - suitable
        - proper
        - standard
        - normal
        - usual
        - nice
        - better
        - good

    except:
        - standard input
        - standard output
        - standard error

export word-list OpenListMarkers:
    description: Phrases that end a list without closing it.
    words:
        - etc
        - and so on
        - and others
        - and more
        - and the like

export word-list Deferrals:
    description:
        Phrases that send the reader elsewhere instead of saying the thing
        here.

    words:
        - later
        - previously
        - we'll discuss
        - we'll cover
        - whole section
        - entire section
        - already discussed
        - as mentioned
        - in future
        - when we talk about

export word-list FirstPerson:
    description: Words that mark the author speaking to the reader.
    words:
        - i
        - i'm
        - i've
        - my
        - me
        - let's
        - you'd

export word-list Unfinished:
    description:
        Markers left on unfinished text. They only match in capitals.

    matchCase: true
    words:
        - TODO
        - TBD
        - FIXME
        - XXX

export word-list Abbreviations:
    description: Abbreviations whose period never ends a sentence.
    words:
        - e.g.
        - i.e.
        - vs.
        - cf.

export word-list ContainerProperties:
    description:
        Property names that hold prose about their owner rather than naming a
        part of it. Statements inside them are about the owner.

    words:
        - description
        - prompt
        - notes
        - summary
        - overview
        - about

export word-map AbleForms:
    description:
        Verbs whose able form is a word in its own right. Click has
        clickable, so can be clicked and clickable name the same capability.

    pairs:
        click: clickable
        select: selectable
        edit: editable
        drag: draggable
        focus: focusable
        scroll: scrollable
        sort: sortable
        resize: resizable

export word-map ActionNouns:
    description:
        Verbs and the nouns that name one occurrence of them, so that accepts
        clicks can be recognized as being about clicking.

    pairs:
        click: [click, clicks]
        select: [selection, selections]
        drag: [drag, drags]
        edit: [edit, edits]
        submit: [submission, submissions]

export word-list TransformationVerbs:
    description:
        Verbs that describe changing an existing value rather than setting a
        new one. The button is dimmed says something is done to the button's
        appearance; it does not name a new appearance.

    words:
        - dim
        - brighten
        - highlight
        - hide
        - show
        - blur
        - shrink
        - enlarge
        - fade

export word-map RelationVerbs:
    description:
        Verbs that relate one thing to another, each paired with the kind of
        relationship it expresses, as named in @{Relationships}.

    pairs:
        contains: contains
        holds: contains
        includes: contains
        requires: requires
        needs: requires
        uses: requires
        references: references
        invokes: invokes
        calls: invokes
        triggers: invokes
        changes: modifies
        updates: modifies

export value-class Colors:
    description: Color names describe a color.
    aspect: color
    words:
        - red
        - orange
        - yellow
        - green
        - blue
        - purple
        - pink
        - brown
        - black
        - white
        - gray
        - grey

export value-class Sizes:
    description: Size words describe a size.
    aspect: size
    words:
        - tiny
        - small
        - medium
        - large
        - huge

export value-class Visibility:
    description: Visibility words describe whether something can be seen.
    aspect: visibility
    words:
        - visible
        - hidden
        - invisible

export WORD_LISTS:: extends WordList[]:
    - {Negations}
    - {Modals}
    - {ConditionMarkers}
    - {Pronouns}
    - {Determiners}
    - {Conjunctions}
    - {Hedges}
    - {DegreeWords}
    - {VagueWords}
    - {OpenListMarkers}
    - {Deferrals}
    - {FirstPerson}
    - {Unfinished}
    - {Abbreviations}
    - {ContainerProperties}
    - {TransformationVerbs}

export WORD_MAPS:: extends WordMap[]:
    - {AbleForms}
    - {ActionNouns}
    - {RelationVerbs}

export VALUE_CLASSES:: extends ValueClass[]:
    - {Colors}
    - {Sizes}
    - {Visibility}
