from ./OpenItems import
    Ambiguity,
    Contradiction,
    Gap,
    OpenItemKind,
    Unrecognized
from ../LanguageData import
    Deferrals,
    DegreeWords,
    Hedges,
    OpenListMarkers,
    TransformationVerbs,
    Unfinished,
    VagueWords
from ../measures/Expectations import Expectations

export abstract anchor DetectionRule as detection-rule:
    finds:: OpenItemKind
    description:: string
    rule:: string
    reports:: string

export abstract anchor GapRule extends DetectionRule as gap-rule:
    finds: {Gap}

export abstract anchor AmbiguityRule extends DetectionRule as ambiguity-rule:
    finds: {Ambiguity}

export abstract anchor ContradictionRule extends DetectionRule as contradiction-rule:
    finds: {Contradiction}

export anchor DetectionRules:
    description:
        A detection rule looks through the model for one kind of open item.
        Each rule is declared with the keyword of the kind it finds, so a
        gap-rule finds gaps. A rule's name in reports is its anchor name in
        kebab-case: IntroducedPart is introduced-part. The reports line of
        each rule shows exactly how its open items are worded.

        Some rules look at facts, some at statements, and some at the text
        and structure directly, because an empty property or a TODO is a gap
        whether or not any fact was drawn from it.

    rules: {DETECTION_RULES}

export gap-rule IntroducedPart:
    description: A part is used by path, but nothing defines it.
    rule:
        A name resolved as introduced: a possessive whose owner has no such
        part or aspect. One open item per introduced path, listing every
        statement that uses it.

    reports: Button.action is used but never defined.

export gap-rule UndefinedTransformation:
    description: A value is transformed, but the transformation is never defined.
    rule:
        A fact whose value applies a verb from @{TransformationVerbs}, where
        no entity, part or fact in the specification defines that verb, by
        name matching as in resolution.

    reports: dim is applied to Button.color but never defined.

export gap-rule UnquantifiedDegree:
    description: A statement says how much, without saying how much.
    rule: A statement with a modifier from @{DegreeWords}, attached to the fact it produced.
    reports: slightly gives no amount for dim(Button.color).

export gap-rule UndefinedCriterion:
    description: A judgment word stands in for a criterion nobody wrote down.
    rule: A statement containing a word from @{VagueWords}, and no hedge.
    reports: better is a judgment with no criterion.

export gap-rule IncompleteList:
    description: A list ends without closing, so its full membership is unknown.
    rule: A statement containing a phrase from @{OpenListMarkers}.
    reports: etc leaves the list of output formats open.

export gap-rule UnlinkedDeferral:
    description: The text says the answer is somewhere else, without a link.
    rule: A statement containing a phrase from @{Deferrals}, in a paragraph with no Piton reference.
    reports: later points elsewhere without a link.

export gap-rule UnfinishedText:
    description: The author marked text as unfinished.
    rule: A comment, paragraph or code block containing a marker from @{Unfinished}.
    reports: Marked TODO: write this section.

export gap-rule CutOffStatement:
    description: A statement stops partway through.
    rule:
        The last statement of a paragraph that ends without punctuation, and
        whose last word is a determiner, preposition or conjunction, unless a
        code block follows it directly.

    reports: The statement stops at with.

export gap-rule EmptyProperty:
    description: A property is named, but given nothing.
    rule: A property with no value, no type constraint, and nothing indented beneath it.
    reports: Button.tone has no value.

export gap-rule SemanticallyEmpty:
    description:
        An entity is valid Piton, but says nothing: it has no facts beyond the
        structural ones that name its parts and bases.

    rule:
        An entity whose only facts are Defines, Inherits and References
        relations, and which has no statements or examples. A valid anchor can
        be almost empty of meaning, and this is how analysis tells the two
        apart.

    reports: Button is declared, but nothing about it is specified.

export gap-rule UnansweredExpectation:
    description: An expectation the project configured asks a question the specification does not answer.
    rule: A question from an expectation, as described in @{Expectations}, with no answering fact.
    reports: InteractiveComponent expects Button.action to be defined.

export gap-rule UnreachableFile:
    description: A file is never reached from the entry, so it is never compiled.
    rule: In a whole-project analysis, a file the entry does not reach through imports or use.
    reports: scope/draft/Button.pi is not reached from the entry.

export ambiguity-rule AmbiguousName:
    description: A name fits more than one thing.
    rule: A name whose first answering resolution step found more than one candidate.
    reports: the label could mean Button.label or Label.

export ambiguity-rule CompetingReadings:
    description: A statement can be read more than one way, and the readings give different facts.
    rule:
        A statement where word classes, patterns, equivalence rules, or the
        choice between a state and an event condition leave more than one
        reading, and the readings give different facts.

    reports: when selected could be the state selected or the event select.

export ambiguity-rule UncommittedStatement:
    description: A hedge leaves open whether the statement binds.
    rule: A statement containing a word from @{Hedges}; its fact is uncommitted.
    reports: usually leaves open whether Button.color = blue is required.

export contradiction-rule ConflictingFacts:
    description: Two facts about the same thing cannot both be true.
    rule: Two facts that contradict, as defined for Contradiction.
    reports: Button.color is blue (button.pi:6) and red (theme.pi:12) under the same conditions.

export contradiction-rule ValueOutsideChoice:
    description: A value is given that a choice does not allow.
    rule: A fact giving subject.aspect a value outside a choice fact about the same subject.aspect.
    reports: Button.state = hidden, but Button.state is one of enabled, disabled.

export contradiction-rule CompilerError:
    description: The specification breaks its own language rules.
    rule: Every error the compiler reports for an analyzed file, including files never reached from the entry.
    reports: "Compiler: cannot find Template in this scope."

export contradiction-rule ExampleMismatch:
    description: A worked example does not compile, or does not produce the result it claims.
    rule:
        A code block fenced as piton that does not compile on its own, or
        that is followed, in the same property, by a json code block it does
        not produce. A block fenced as piton fragment is exempt from
        compiling on its own, because it is deliberately incomplete: it shows
        one file of several, continues an earlier block, or demonstrates an
        error.

    reports: The example's stated result gives name as Child Anchor; it compiles to Base Anchor.

export contradiction-rule DuplicateKey:
    description: A key is written twice in one block, and the compiler accepts both.
    rule: A key that appears more than once in the same block.
    reports: tone is defined twice in Button.

export contradiction-rule SharedIdentity:
    description: Sibling anchors share a value meant to tell them apart.
    rule:
        Concrete anchors with the same keyword or first base that give the same
        value to a property named symbol, name, id or key.

    reports: MergeOperator and ConcatenationOperator both have symbol +.

export detection-rule UnrecognizedStatement:
    finds: {Unrecognized}
    description: A normative statement matched no pattern.
    rule: A statement, not a question or aside, from which no pattern produced a fact.
    reports: Not understood, about Button when Button.state = disabled: The button looks better when disabled.

export DETECTION_RULES:: extends DetectionRule[]:
    - {IntroducedPart}
    - {UndefinedTransformation}
    - {UnquantifiedDegree}
    - {UndefinedCriterion}
    - {IncompleteList}
    - {UnlinkedDeferral}
    - {UnfinishedText}
    - {CutOffStatement}
    - {EmptyProperty}
    - {SemanticallyEmpty}
    - {UnansweredExpectation}
    - {UnreachableFile}
    - {AmbiguousName}
    - {CompetingReadings}
    - {UncommittedStatement}
    - {ConflictingFacts}
    - {ValueOutsideChoice}
    - {CompilerError}
    - {ExampleMismatch}
    - {DuplicateKey}
    - {SharedIdentity}
    - {UnrecognizedStatement}
