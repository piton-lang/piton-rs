use ../cli

export cli-command Check:
    commandName: check

    positionalArguments:
        path: Optional file or glob. Defaults to the project.

    description:
        Checks specific files or the project and reports errors.

        The check itself never writes a file. Before it, the host offers the
        findings of inspect hooks as before every command, but the check runs
        on the project as it is. A migration the user accepts is applied by
        the host after the check ends, not by the check.

    emit: false

    validate:
        - syntax
        - imports
        - references
        - types
        - inheritance
        - composition
        - exports
        - circular-dependencies

    diagnostics:
        errors: true
        warnings: true

    exitCode:
        success: 0
        errors: 1
