use ../cli

export cli-command Check:
    commandName: check

    positionalArguments:
        path: Optional file or glob. Defaults to the project.

    description:
        Checks specific files or the project and reports errors

    emit: false

    validate:
        - syntax
        - imports
        - references
        - types
        - inheritance
        - composition
        - exports
        - circular-dependencies

    diagnostics:
        errors: true
        warnings: true

    exitCode:
        success: 0
        errors: 1
