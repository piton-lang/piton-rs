from ./Agent import AgentCli
from ./Build import Build
from ./Check import Check
from ./Compile import Compile
from ./Format import Format
from ./Init import Init
from ./Loc import Loc
from ./Lsp import Lsp
from ./Reach import Reach
from ./Slice import Slice
from ./package-management import
    Remove,
    Tether,
    Untether,
    Update

export anchor Cli:
    description:
        The CLI compiler is a command-line tool that allows you to compile Piton
        files into output. It also includes helper commands like format.

    commands:
        - @{AgentCli}
        - @{Build}
        - @{Check}
        - @{Compile}
        - @{Format}
        - @{Init}
        - @{Loc}
        - @{Lsp}
        - @{Reach}
        - @{Remove}
        - @{Slice}
        - @{Tether}
        - @{Untether}
        - @{Update}

export abstract anchor CliCommand as cli-command:
    description:: string: Command invokable by the cli by running piton <command>
    commandName:: string

    positionalArguments:: dictionary:: null: null
    namedArguments:: dictionary:: null: null
