use ../cli

export cli-command Format:
    commandName: format
    positionalArguments:
        path: file or glob

    namedArguments:
        check: Only check the files, and report problems.  Don't write.

    description:
        Applies canonical formatting.

        Without a path, it formats every source file beneath the source root,
        however many there are. Build output, dependency directories and
        installed packages are left alone.
