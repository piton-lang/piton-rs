use @piton/belay
use @piton/config

from @piton/belay import
    ClaudeCodeAdapter,
    CodexAdapter,
    OpenCodeAdapter

export piton-config Project:
    root: ./spec
    entry: ./spec/index.pi

    frameworks:
        - {Belay}

belay-config Belay:
    codeRoot: ./src
    shapeRoot: ./spec/shape

    adapters:
        - {ClaudeCodeAdapter}
        - {CodexAdapter}
        - {OpenCodeAdapter}
