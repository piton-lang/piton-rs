%YAML 1.2
---
# Generated by `piton grammar`.
name: Piton
file_extensions: [pi]
scope: source.piton

contexts:
  main:
    - include: fenced-code
    - include: comment
    - include: declaration
    - include: key
    - include: value

  # A fenced code block is kept as written, so nothing inside it is Piton.
  fenced-code:
    - match: '^\s+(`{3,}(?=[^`]*$)|~{3,}).*$'
      scope: punctuation.definition.raw.code-fence.begin.piton
      embed: raw
      embed_scope: markup.raw.block.piton
      escape: '^\s*\1[`~]*\s*$'
      escape_captures:
        0: punctuation.definition.raw.code-fence.end.piton

  raw:
    - meta_include_prototype: false

  comment:
    - match: '(?:^|(?<=\s))//.*$'
      scope: comment.line.double-slash.piton

  declaration:
    - match: '^\s*(?:(abstract|extends|anchor|export|import|from|use|as)\s+)*(anchor)\s+([A-Za-z_][\w-]*)'
      captures:
        1: keyword.control.piton
        2: keyword.control.piton
        3: entity.name.type.piton
    - match: '\b(abstract|extends|anchor|export|import|from|use|as)\b'
      scope: keyword.control.piton

  key:
    - match: '^\s*([\w][\w-]*)(?=\s*(?:::|:)(?:\s|$))'
      scope: entity.name.tag.piton
    - match: '(::)\s*(?:(extends)\s+)?\b(dictionary|boolean|complex|string|number|anchor|simple|null|list|any|[A-Za-z_][\w-]*)\b'
      captures:
        1: keyword.operator.piton
        2: keyword.control.piton
        3: support.type.piton
    - match: '^\s*(-)(?=\s)'
      scope: punctuation.definition.list.piton
    - match: '^\s*(\+\+?)(?=\s)'
      scope: keyword.operator.piton

  value:
    # An escape group is kept as written, so nothing inside it is Piton. Its
    # closing delimiter repeats the opening one's backslashes, exactly as many,
    # which is what lets a longer delimiter hold a shorter one.
    - match: '(?<![^\s(\[,])(\\+) (?:.*? )?\1(?!\\)'
      scope: string.unquoted.escape-group.piton
      captures:
        1: constant.character.escape.piton
    - match: '\\.'
      scope: constant.character.escape.piton
    - match: '([^\s{}\[\](),"]*)(\{)'
      captures:
        1: keyword.other.sigil.piton
        2: punctuation.section.embedded.begin.piton
      push: interpolation
    - match: '"'
      scope: punctuation.definition.string.begin.piton
      push: string
    - match: '\b\d[\d_]*(?:\.\d[\d_]*)?\b'
      scope: constant.numeric.piton
    - match: '\b(false|true|null)\b'
      scope: constant.language.piton

  interpolation:
    - meta_scope: meta.embedded.piton
    - match: '\}'
      scope: punctuation.section.embedded.end.piton
      pop: true
    - match: '\b(super|this|self)\b'
      scope: variable.language.piton
    - match: '\b(false|true|null)\b'
      scope: constant.language.piton
    - match: '\b\d[\d_]*(?:\.\d[\d_]*)?\b'
      scope: constant.numeric.piton
    - match: '(\+\+|&&|\|\||==|!=|>=|<=|[-+*/%<>?:.])'
      scope: keyword.operator.piton
    - match: '\b[A-Za-z_][\w-]*\b'
      scope: variable.other.piton

  string:
    - meta_scope: string.quoted.double.piton
    - match: '\\.'
      scope: constant.character.escape.piton
    - match: '"'
      pop: true
