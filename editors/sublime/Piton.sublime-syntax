%YAML 1.2
---
# Piton for Sublime Text.
#
# Every scope here is one of the canonical names in
# `editors/fixtures/scopes.toml`, the same names the TextMate grammar uses,
# and what the definition paints is tested against the parser by
# `crates/piton-syntax/tests/highlight_corpus.rs` (through syntect, which runs
# this format without Sublime installed).
#
# Prose has no scope. It is most of every file, and showing it in the plain
# text style is what lets keys, declarations and expressions stand out; a
# quoted string inside an expression keeps the string colour.
name: Piton
file_extensions: [pi]
scope: source.piton
version: 2

variables:
  keyword_name: '[a-z][a-z0-9]*(?:-[a-z0-9]+)*'
  # A key is letters, digits, `_` and `-`, as the parser reads it.
  key: '[\p{L}\p{N}_][\p{L}\p{N}_-]*'
  name: '[\p{L}_][\p{L}\p{N}_-]*'
  word_end: '(?![\p{L}\p{N}_-])'
  word_start: '(?<![\p{L}\p{N}_-])'
  builtin_type: '(?:string|number|boolean|null|list|dictionary|anchor|reference|any|simple|complex){{word_end}}'
  # The whole-value number: the compiler's `is_number_literal`.
  number: '-?\d(?:_?\d)*(?:\.\d(?:_?\d)*)?'
  constraint: '::\s+(?:extends\s+)?{{name}}(?:\[\])?'

contexts:
  main:
    - include: escape-block
    - include: fence
    - include: comment
    - include: import
    - include: pass
    - include: declaration
    - include: literal-item
    - include: property
    - include: markers
    - include: inline-escape
    - include: interpolation

  # A line of backslashes opens a block whose contents are literal, and a line
  # of the same number closes it.
  escape-block:
    - match: '^(\s*)(\\+)\s*$'
      captures:
        2: constant.character.escape.piton
      push:
        - meta_content_scope: string.unquoted.verbatim.piton
        - match: '^\s*(\2)\s*$'
          captures:
            1: constant.character.escape.piton
          pop: true

  # A code fence is text, and the lines inside it are Piton like any others.
  # An escape block directly inside a fence that names a language is shown as
  # that language.
  fence:
    - match: '^\s*```piton\s*$'
      push: [fence-body, fence-piton]
    - match: '^\s*```json\s*$'
      push: [fence-body, fence-json]
    - match: '^\s*```yaml\s*$'
      push: [fence-body, fence-yaml]

  fence-body:
    - match: '^\s*```\s*$'
      pop: true
    - include: main

  fence-piton:
    - match: '^(\s*)(\\+)\s*$'
      captures:
        2: constant.character.escape.piton
      embed: scope:source.piton
      embed_scope: meta.embedded.block.piton
      escape: '^\s*(\2)\s*$'
      escape_captures:
        1: constant.character.escape.piton
    - match: '(?=\S|^)'
      pop: true

  fence-json:
    - match: '^(\s*)(\\+)\s*$'
      captures:
        2: constant.character.escape.piton
      embed: scope:source.json
      embed_scope: meta.embedded.block.json
      escape: '^\s*(\2)\s*$'
      escape_captures:
        1: constant.character.escape.piton
    - match: '(?=\S|^)'
      pop: true

  fence-yaml:
    - match: '^(\s*)(\\+)\s*$'
      captures:
        2: constant.character.escape.piton
      embed: scope:source.yaml
      embed_scope: meta.embedded.block.yaml
      escape: '^\s*(\2)\s*$'
      escape_captures:
        1: constant.character.escape.piton
    - match: '(?=\S|^)'
      pop: true

  # A comment has to be on its own line. At the end of a line of code `//` is
  # just text, so `url: https://example.com // note` is all value.
  comment:
    - match: '^\s*(//).*$'
      scope: comment.line.double-slash.piton

  # Imports and declarations are top-level only: an indented `use the spec`
  # is prose.
  import:
    - match: '^(use)\s+(\S+)'
      captures:
        1: keyword.control.piton
        2: string.unquoted.module-path.piton
    # A long import list continues on indented lines, so the names run until a
    # line at the margin or a blank one. Only capitalisation says whether an
    # imported name is an anchor.
    - match: '^(from)\s+(\S+)\s+(import|export)(?=\s|$)'
      captures:
        1: keyword.control.piton
        2: string.unquoted.module-path.piton
        3: keyword.control.piton
      push: import-names
    # `export Name` re-exports something already declared or imported.
    - match: '^(export)\s+(?=\S+\s*$)'
      captures:
        1: keyword.control.piton
      push: reexport-name

  import-names:
    - match: '^(?=\S)|^\s*$'
      pop: true
    - include: names

  reexport-name:
    - include: names
    - match: '$'
      pop: true

  names:
    - match: '{{word_start}}\p{Lu}[\p{L}\p{N}_-]*'
      scope: entity.name.type.piton
    - match: '{{word_start}}[\p{Ll}_][\p{L}\p{N}_-]*'
      scope: variable.other.piton

  pass:
    - match: '^\s*(pass)\s*$'
      captures:
        1: keyword.control.piton

  # `[export] [abstract] <keyword> Name [extends A, B] [as kw]:` -- the keyword
  # may be user-defined.
  declaration:
    - match: '^(?:(export)\s+)?(?:(abstract)\s+)?({{keyword_name}})\s+({{name}})(?=(?:\s+extends\s+[^:]+?)?(?:\s+as\s+{{keyword_name}})?\s*:\s*$)'
      captures:
        1: keyword.control.piton
        2: keyword.control.piton
        3: keyword.control.piton
        4: entity.name.type.declaration.piton
      push: declaration-tail

  declaration-tail:
    - match: '{{word_start}}(extends){{word_end}}'
      captures:
        1: keyword.control.piton
      push: bases
    - match: '{{word_start}}(as)\s+({{keyword_name}})'
      captures:
        1: keyword.control.piton
        2: keyword.control.piton
    - match: ':'
      pop: true
    - match: '$'
      pop: true

  bases:
    - match: '(?=\s+as\s|\s*:)'
      pop: true
    - match: '{{name}}'
      scope: entity.name.type.piton

  # A value that is exactly a number, `true`, `false` or `null` is that
  # literal: `3 apples`, `true story` and `.5` are text.
  literal-item:
    - match: '^\s*(-)\s+(?:({{number}})|(true|false|null))\s*$'
      captures:
        1: punctuation.definition.list.begin.piton
        2: constant.numeric.piton
        3: constant.language.piton

  # A key is followed by any constraints, then a colon before whitespace or the
  # end of the line. A required property in an abstract anchor has constraints
  # and no colon. Keywords are keys here too.
  property:
    - match: '^\s*(?:(export)\s+)?({{key}})(?=(?:{{constraint}})*:(?:\s|$)|(?:{{constraint}})+\s*$)'
      captures:
        1: keyword.control.piton
        2: variable.other.property.piton
      push: constraints

  constraints:
    - match: '(::)\s*(?:(extends)\s+)?({{builtin_type}})(\[\])?'
      captures:
        2: keyword.control.piton
        3: support.type.builtin.piton
    - match: '(::)\s*(?:(extends)\s+)?({{name}})(\[\])?'
      captures:
        2: keyword.control.piton
        3: entity.name.type.piton
    - match: '(:)\s+(?:({{number}})|(true|false|null))\s*$'
      captures:
        2: constant.numeric.piton
        3: constant.language.piton
      pop: true
    - match: ':'
      pop: true
    - match: '$'
      pop: true

  markers:
    # A list item is never a key: `- Settings:` is the string `Settings:`.
    - match: '^\s*(-)(?=\s|$)'
      captures:
        1: punctuation.definition.list.begin.piton
    # `+` merges and deduplicates; `++` keeps duplicates.
    - match: '^\s*(\+\+?)(?=\s|$)'
      captures:
        1: keyword.operator.piton

  # `\ {1 + 2} \` is the text `{1 + 2}`: an inline escape opens nothing, so it
  # comes before the interpolation rule and has no inner rules.
  inline-escape:
    - match: '(?<!\\)(\\)(?!\\) '
      captures:
        1: constant.character.escape.piton
      push:
        - match: ' (\\)(?!\\)'
          captures:
            1: constant.character.escape.piton
          pop: true
        - match: '$'
          pop: true

  # Four sigils: intrinsic, string, numeric, and reference.
  interpolation:
    - match: '\$\{|#\{|@\{|\{'
      scope: punctuation.section.embedded.piton
      push: expression

  expression:
    - meta_scope: meta.embedded.expression.piton
    - match: '\}'
      scope: punctuation.section.embedded.piton
      pop: true
    - include: interpolation
    - match: '{{word_start}}(?:true|false|null){{word_end}}'
      scope: constant.language.piton
    - match: '{{word_start}}(?:this|self|super){{word_end}}'
      scope: variable.language.piton
    # A leading digit is required; minus is never a prefix in an expression.
    - match: '{{word_start}}\d(?:_?\d)*(?:\.\d(?:_?\d)*)?'
      scope: constant.numeric.piton
    - match: '"(?:[^"\\]|\\.)*"'
      scope: string.quoted.double.piton
    # A name after `.` is a key, whatever its case.
    - match: '(\.)\s*({{name}})'
      captures:
        1: keyword.operator.piton
        2: variable.other.property.piton
    - match: '\+\+|==|!=|<=|>=|&&|\|\||[+\-*/%<>!?:.]'
      scope: keyword.operator.piton
    - include: names
