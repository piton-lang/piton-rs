{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""]],
  "indentationRules": {
    "increaseIndentPattern": "^[^-+/\\s][^:]*:\\s*$|^\\s*[^-+:/\\s][^:/\\s]*(::\\s*[^:/\\s]+)*:\\s*$",
    "decreaseIndentPattern": "^(?!)"
  },
  "onEnterRules": [
    {
      "beforeText": "^[^-+/\\s][^:]*:\\s*$|^\\s*[^-+:/\\s][^:/\\s]*(::\\s*[^:/\\s]+)*:\\s*$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^\\s{4,}$",
      "action": { "indent": "outdent" }
    }
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_-]*"
}
