{
  "name": "tree-sitter-piton",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for the Piton language",
  "main": "bindings/node",
  "keywords": ["parser", "piton"],
  "license": "MIT",
  "scripts": {
    "build": "tree-sitter generate",
    "test": "tree-sitter test"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.24.0"
  },
  "tree-sitter": [
    {
      "scope": "source.piton",
      "file-types": ["pi"],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm"
    }
  ]
}
