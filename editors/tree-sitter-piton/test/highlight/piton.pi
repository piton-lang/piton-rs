// A highlight corpus for `tree-sitter test`.

anchor Example:
// <- keyword
//     ^ type.definition
    name: a plain sentence
//  ^ property
//        ^ string
    count: 42
//         ^ number
    flag: true
//        ^ constant.builtin
    quoted: "text"
//          ^ string
    computed: {self.name}
//            ^ keyword.operator
//             ^ variable.builtin
    greeting: Hello, ${name}
//            ^ string
//                   ^ keyword.operator
    url: https://example.com/a//b
//       ^ string.special.url
    hyphen: a well-known thing
//          ^ string

skill BuildIt:
// <- keyword.function
//    ^ type.definition

from ./other import Thing
// <- keyword
//   ^ string.special.path
//                  ^ variable
