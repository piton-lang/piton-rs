use @piton/belay

from /shape/ui/body/EditorSurface import EditorSurface

// Guidance for the go to line dialog, in src/ui/body.
export instruction GoToLineDialog:
    description: The small modal for jumping the caret to a line number

    prompt:
        A modal window centred over the body, holding one number field, a Go
        button and a Cancel button. It exists because a line number is the one
        piece of navigation that does not deserve a docked panel.

    behaviour:
        - Opens with the current line number in the field, selected, and the field focused
        - Accepts digits only, and Go is disabled while the field is empty
        - Enter is Go and Escape is Cancel
        - A number past the end of the document goes to the last line, and the footer says which line it landed on
        - Going moves the caret to the start of the line and scrolls @{EditorSurface} so the line sits in the middle third
        - The rest of the window is dimmed while it is open and does not respond to the keyboard
