// The values everything else is drawn from.
//
// Anchors, not instructions: these are numbers and colours that many documents
// point at, and they should read the same wherever they are read from.
export anchor Tokens:
    spacing:
        step: 4
        gutter: 12
        band: 8

    radius:
        control: 6
        panel: 10

    type:
        ui: 13
        editor: 14
        small: 11

    motion:
        hover: 80
        panel: 120

    units: Spacing, radius and type in points; motion in milliseconds

// The light palette. The editor starts here when the system has no preference.
export anchor LightTokens extends Tokens:
    surface: "#ffffff"
    surfaceMuted: "#f4f5f7"
    surfaceHover: "#e9ebef"
    foreground: "#16181d"
    foregroundMuted: "#5f6672"
    hairline: "#dfe2e8"
    accent: "#2f6feb"
    selection: "#cfe0ff"
    danger: "#c0392b"

// The dark palette. Same names, same meanings, different values.
export anchor DarkTokens extends Tokens:
    surface: "#16181d"
    surfaceMuted: "#1c1f26"
    surfaceHover: "#262a33"
    foreground: "#e6e8ec"
    foregroundMuted: "#9aa1ad"
    hairline: "#2b2f38"
    accent: "#5c96ff"
    selection: "#2c4a80"
    danger: "#e56a5a"
