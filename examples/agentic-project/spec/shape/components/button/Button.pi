use @piton/belay

from ./ButtonDesign import ButtonDesign

// Guidance that lands next to src/components/button.
export instruction ButtonComponent:
    description: The clickable button component

    prompt:
        The button component should be clickable and should have a hover state.

        For details about the design, read @{ButtonDesign}.

    api:
        label: The visible text, required
        onPress: Called on click and on Enter
        disabled: Defaults to false
