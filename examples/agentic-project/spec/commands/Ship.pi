use @piton/belay

// Runs the checks that have to pass before anything leaves the branch.
export command Ship:
    description: Runs the tests and the Piton checks, then reports what is left
    allowedTools: Bash, Read, Grep
    model: sonnet

    prompt:
        Run the test suite and `piton build check`. Report what failed and stop;
        do not fix anything without being asked.

    checks:
        - cargo test
        - piton build check
        - piton format . --check
