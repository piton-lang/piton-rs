use @piton/belay

from @piton/belay import __BELAY_SHAPE__

from /shape import ButtonComponent

// Builds code from the shape tree.
export skill BuildFromShape:
    description: Implements a component from its shape document
    useWhen: the user asks to build or change a component that has a shape document

    prompt:
        Build following the structure outlined in {__BELAY_SHAPE__}.

        Read the shape document for the component first, then write the code to
        match it. Do not invent behaviour the shape does not describe.

    components:
        - @{ButtonComponent}
